-- Human-facing metadata: tooling and the manager's detail pane read this.
return {
  summary = "Thirty more COLORS palettes and eight new text-box borders: Amiga, C64, Virtual Boy, rainbow, vaporwave.",
  author = "MadeinTaly",
  support = "https://linktr.ee/made_in_taly",
  tags = { "cosmetic", "ui", "palette", "retro" },
  compat = { modApi = 2, games = { "gen1", "gen2" } },
  differences = {
    added = {
      "thirty palettes appended to the engine's own COLORS row (Red/Blue/Yellow) and Gold's own COLOR row alike, cycled by the same option and the same hotkey on either game",
      "FRAME: eight new borders for every text box and menu, drawn as a glyph page of this mod's own and pointed at through Font.BORDER, plus GAME BOY for the engine's six",
      "USE ADVANCED, which rides the engine's own per-tile colorization instead of replacing it: on Red/Blue/Yellow a palette recolours the eighteen-plus colours the pokered-gbc pack puts on screen rather than flattening them to four; on Gold, the same option rides GbcPalette.resolve, the seam every one of Gold's own colours already passes through, recolouring its BG groups, OBJ groups, mon and trainer pics, HP/EXP bars and menu chrome instead of collapsing them to four shared shades",
      "A on the engine's own OPTION -> COLORS row (or Gold's OPTION -> COLOR row) lifts the menu off the game and previews the palette on it, name only, left/right to walk the list -- attached through ui.options.rows as an activate on the row the engine owns, so the row still steps exactly as before",
      "START -> PALETTE, the same browser mid-game on both generations: the screen is not opaque, so colorisation recolours the actual frame rather than a swatch",
      "PREVIEW, which removes both ways into that browser and leaves the palettes",
      "PACKS, narrowing them to the twelve hardware ones or the eighteen invented ones",
    },
    changed = {
      "nothing about the vanilla seven Gen 1 modes, or Gold's own three: they keep their positions, so a save pointing at SGB (Gen 1) or GBC (Gold) still lands there",
      "several palettes' weaker adjacent-rung contrast tightened (AMIGA, CGA, VAPOR) -- judged by WCAG relative luminance rather than by eye; every id kept its colour identity, only the specific rung that was flattest against its neighbour moved",
    },
    known = {
      "the FRAME half runs identically on both generations: Gold draws its boxes through Chrome.box -> Font.drawBox, which reads the same Font.BORDER codes this mod rewrites, and Gold's own FRAME row picks a frame PAGE rather than the border glyphs, so the two are orthogonal",
      "the palette half now runs on Gold too, through src/render/GbcPalette.lua's `resolve` -- the module Gold's own COLOR option already uses -- rather than through PaletteFX, which Gold's renderer never calls",
      "Gold's title screen and the Gold/Silver boot cinema are the one surface this does not reach: TitleState:gray() (src/ui/gen2/TitleState.lua:183-187) swaps to pre-rendered grey art for any COLOR mode but GBC, the same branch DMG and CLASSIC already land on, so a groovy scheme shows the grey splash and picks up the recolour from the first menu or map onward",
      "four shades is four shades on Red/Blue/Yellow without ADVANCED -- these recolour the Game Boy's ramp, they do not add colours to a scene; on Gold the ramp is what USE ADVANCED = OFF asks for specifically, TINT and FULL keep Gold's own variety",
      "a palette must fall in brightness or the picture reads inside out, so every one here is checked by luminance rather than by eye; AMIGA had to be reordered away from Workbench's own layout because its orange is brighter than its blue",
      "VBOY is lifted toward white-hot at the top rung: a ramp of saturated reds has too little luminance range to stay legible",
      "disable the mod with one of its palettes saved and the game falls back to SGB (Gen 1) or GBC (Gold) rather than breaking -- the id simply stops resolving on either engine module",
      "a border is six glyphs and h/v are each shared by two opposite edges, so a rail sits on one set of rows/columns for both -- which makes rounded corners and rippling rails impossible rather than merely hard, and the eight frames here are generated from that rule",
      "the pack appends to PaletteFX.MODES and GbcPalette.MODES, both plain module arrays; a future engine release could make either a registry, which would need a rewrite here",
    },
  },
}
